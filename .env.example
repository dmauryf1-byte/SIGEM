# Copiar a .env (Copy-Item .env.example .env) y cambiar las contraseñas. .env nunca va a Git.

# MySQL (docker-compose.yml). El usuario de la app es siempre "sigem".
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_PASSWORD=cambia-esta-clave-app

# Backend (backend/app/core/config.py)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sigem

# Autenticación (SIGEM-004). Generar un secreto propio de 32+ caracteres:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# false solo en local (http); en producción con https, true
COOKIE_SECURE=false
